# ============================================================
# Build Valhalla from source + compile campus_pedestrian plugin
# ============================================================
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Install Valhalla build + runtime deps
RUN apt-get update && apt-get install -y \
    cmake \
    autoconf-archive \
    build-essential \
    ccache \
    curl \
    git \
    libboost-all-dev \
    libczmq-dev \
    libcurl4-openssl-dev \
    libgeos-dev \
    libluajit-5.1-dev \
    liblz4-dev \
    libprotobuf-dev \
    libprotobuf-c-dev \
    libprotoc-dev \
    libspatialite-dev \
    libsqlite3-dev \
    libsqlite3-mod-spatialite \
    libtool \
    libzmq3-dev \
    pkg-config \
    protobuf-compiler \
    python3-all-dev \
    spatialite-bin \
    unzip \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Build prime_server from source (Valhalla HTTP dependency)
WORKDIR /tmp
RUN git clone --depth 1 --recurse-submodules https://github.com/kevinkreiser/prime_server.git
WORKDIR /tmp/prime_server
RUN ./autogen.sh && ./configure --prefix=/usr/local && make -j$(nproc) && make install

# Build Valhalla from source
ARG VALHALLA_VERSION=3.4.0
WORKDIR /tmp
RUN git clone --depth 1 --recurse-submodules --branch ${VALHALLA_VERSION} https://github.com/valhalla/valhalla.git
WORKDIR /tmp/valhalla/build
# Fix GCC 13 compat issues in Valhalla 3.4.0
RUN sed -i '1i #include <cstdint>' /tmp/valhalla/valhalla/baldr/graphconstants.h
RUN set -e; for f in /tmp/valhalla/src/baldr/transit*.cc; do \
      [ -f "$f" ] || continue; \
      grep -q 'std::runtime_error' "$f" || continue; \
      grep -q '#include <stdexcept>' "$f" && continue; \
      sed -i '1i #include <stdexcept>' "$f"; done
RUN cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr/local \
    -DENABLE_CCACHE=OFF \
    -DENABLE_DATA_INSTALL=ON \
    -DENABLE_PYTHON_BINDINGS=OFF \
    -DENABLE_SERVICES=ON \
    -DENABLE_HTTP=ON \
    -DENABLE_TOOLS=ON \
    -DBUILD_TESTING=OFF \
    -DBUILD_SHARED_LIBS=ON
RUN make -j$(nproc)
RUN make install

# ============================================================
# Minimal runtime image
# ============================================================
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    libboost-filesystem1.83.0 \
    libboost-locale1.83.0 \
    libboost-program-options1.83.0 \
    libboost-system1.83.0 \
    libczmq4 \
    libcurl4t64 \
    libgeos-c1t64 \
    libluajit-5.1-2 \
    liblz4-1 \
    libprotobuf-lite32t64 \
    libspatialite8t64 \
    libsqlite3-0 \
    libzmq5 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy Valhalla binaries + libs
COPY --from=builder /usr/local/bin/valhalla* /usr/local/bin/
COPY --from=builder /usr/local/lib/libprime_server* /usr/local/lib/
COPY --from=builder /usr/local/lib/libvalhalla* /usr/local/lib/
ENV LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
    CMD curl -f http://localhost:8002/status || exit 1

ENTRYPOINT ["valhalla_service", "/config/valhalla.json"]
